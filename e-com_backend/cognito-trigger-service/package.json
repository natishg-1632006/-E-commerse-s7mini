{
  "name": "cognito-trigger-service",
  "version": "1.0.0",
  "description": "Serverless Lambda service for Amazon Cognito post-confirmation triggers",
  "main": "lambda.js",
  "private": true,
  "scripts": {
    "deploy": "serverless deploy",
    "remove": "serverless remove",
    "invoke": "serverless invoke local -f postConfirmationTrigger",
    "test": "jest",
    "test:coverage": "jest --coverage --detectOpenHandles --forceExit",
    "test:watch": "jest --watch",
    "lint": "eslint . --quiet",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@aws-sdk/client-cognito-identity-provider": "^3.744.0"
  },
  "devDependencies": {
    "serverless": "^4.38.1",
    "jest": "^29.5.0",
    "supertest": "^6.3.3"
  }
}
